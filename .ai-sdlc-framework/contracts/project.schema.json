{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc.local/contracts/project.schema.json",
  "title": "AI-SDLC project foundation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "frameworkVersion", "projectId", "setup", "defaultBranch", "checks", "frameworkLockSha256"],
  "properties": {
    "schemaVersion": {"const": 1},
    "frameworkVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "projectId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "createdAt", "baselineCommit"],
      "properties": {
        "mode": {"enum": ["NEW_CODEBASE", "ADOPT_EXISTING"]},
        "createdAt": {"type": "string", "format": "date-time"},
        "baselineCommit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "defaultBranch": {"type": "string", "minLength": 1},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600}
        }
      }
    },
    "frameworkLockSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

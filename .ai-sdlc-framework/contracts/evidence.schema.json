{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc.local/contracts/evidence.schema.json",
  "title": "AI-SDLC local evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workId", "subject", "runs", "reviews", "createdAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "workId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headSha", "baseSha", "freezeCommitSha", "specSha256", "frameworkLockSha256"],
      "properties": {
        "headSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "baseSha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "freezeCommitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "specSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "frameworkLockSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "checkId", "command", "headSha", "worktreeSha256", "exitCode", "result", "expectedFailure", "outputSha256", "at"],
        "properties": {
          "kind": {"enum": ["red", "green", "full"]},
          "checkId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "headSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "worktreeSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "exitCode": {"type": "integer"},
          "result": {"enum": ["EXPECTED_FAIL", "PASS", "FAIL"]},
          "expectedFailure": {"type": ["string", "null"], "minLength": 1},
          "outputSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "at": {"type": "string", "format": "date-time"}
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "red"}}},
            "then": {
              "properties": {
                "result": {"enum": ["EXPECTED_FAIL", "FAIL"]},
                "expectedFailure": {"type": "string", "minLength": 1}
              }
            },
            "else": {
              "properties": {
                "result": {"enum": ["PASS", "FAIL"]},
                "expectedFailure": {"const": null}
              }
            }
          },
          {
            "if": {"properties": {"result": {"const": "EXPECTED_FAIL"}}},
            "then": {"properties": {"exitCode": {"not": {"const": 0}}}}
          },
          {
            "if": {"properties": {"result": {"const": "PASS"}}},
            "then": {"properties": {"exitCode": {"const": 0}}}
          }
        ]
      }
    },
    "reviews": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "test"],
      "properties": {
        "implementation": {"$ref": "#/$defs/review"},
        "test": {"$ref": "#/$defs/review"}
      }
    },
    "createdAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "review": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "summary", "findings", "at"],
          "properties": {
            "verdict": {"enum": ["PASS", "BLOCKED"]},
            "summary": {"type": "string", "minLength": 1},
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["severity", "location", "evidence", "impact", "recommendation"],
                "properties": {
                  "severity": {"enum": ["blocking", "warning", "note"]},
                  "location": {"type": "string", "minLength": 1},
                  "evidence": {"type": "string", "minLength": 1},
                  "impact": {"type": "string", "minLength": 1},
                  "recommendation": {"type": "string", "minLength": 1}
                }
              }
            },
            "at": {"type": "string", "format": "date-time"}
          },
          "allOf": [
            {
              "if": {"properties": {"verdict": {"const": "BLOCKED"}}},
              "then": {"properties": {"findings": {"contains": {"properties": {"severity": {"const": "blocking"}}, "required": ["severity"]}, "minContains": 1}}}
            },
            {
              "if": {"properties": {"verdict": {"const": "PASS"}}},
              "then": {"properties": {"findings": {"not": {"contains": {"properties": {"severity": {"const": "blocking"}}, "required": ["severity"]}}}}}
            }
          ]
        }
      ]
    }
  }
}
